# Configuration Serveur
PORT=5000
NODE_ENV=production
CLIENT_URL=*

# Base de Données MongoDB (URL-encodée pour les caractères spéciaux)
MONGODB_URI=mongodb+srv://<user>:<password_encoded>@<cluster>.mongodb.net/montaxi_db?retryWrites=true&w=majority&appName=MonTaxi

# Cache & Files Redis (Railway / Upstash / Render)
REDIS_URL=redis://default:<password>@<host>:<port>

# Sécurité & Authentification JWT
JWT_ACCESS_SECRET=cle_secrete_access_token_tres_longue_et_aleatoire_64_caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cle_secrete_refresh_token_tres_longue_et_aleatoire_64_caracteres
JWT_REFRESH_EXPIRES_IN=30d

# Services Tiers & Géolocalisation
LOCATIONIQ_API_KEY=votre_cle_locationiq
EXPO_ACCESS_TOKEN=votre_token_expo_si_disponible

# Paramètres Geofencing (Abidjan)
DEFAULT_LATITUDE=5.359952
DEFAULT_LONGITUDE=-4.008256
MAX_DISPATCH_RADIUS_KM=15
